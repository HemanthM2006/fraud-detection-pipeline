# Datasets & large generated feature packs (downloaded automatically by notebook)
data/
*.parquet
*.npy
*.joblib
*.zst
*.pkl

# Python & Jupyter artifacts
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
env/
.env

# OS / IDE clutter
.DS_Store
Thumbs.db
.vscode/

# Allow small trained models saved inside outputs/models/ (any sub-folder)
!outputs/models/*.pth
!outputs/models/*.joblib
!outputs/models/**/*.pth
!outputs/models/**/*.joblib

# Fine-tuned transformer weights are ~0.5 GB each (over GitHub's 100 MB limit):
# kept in the private Kaggle dataset hemanthm2006/icfd31k-hinglish-fraud-detector + local copy, never committed
outputs/models/finetuned_transformer/
outputs/models/**/weights/
*.safetensors
*.bin