# Datasets & large generated feature packs (downloaded automatically by notebook)
data/
*.parquet
*.npy
*.joblib
*.zst
*.pkl

# Python & Jupyter artifacts
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
env/
.env

# OS / IDE clutter
.DS_Store
Thumbs.db
.vscode/

# Allow small trained models saved inside outputs/models/
!outputs/models/*.pth
!outputs/models/*.joblib

# Fine-tuned transformer weights are ~0.5 GB (over GitHub's 100 MB limit):
# kept as Kaggle notebook output + local copy, never committed
outputs/models/finetuned_transformer/
*.safetensors
*.bin